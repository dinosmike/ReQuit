<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ReQuit</AssemblyName>
    <RootNamespace>ReQuit</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Vortice.DXGI" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\action-shutdown.png" />
    <Resource Include="Assets\action-signal.png" />
    <Resource Include="Assets\sound-03-minecraft.mp3" />
    <Resource Include="Fonts\consola.ttf" />
    <Resource Include="Fonts\consolab.ttf" />
    <Resource Include="Fonts\segoeui.ttf" />
    <Resource Include="Fonts\segoeuib.ttf" />
    <Resource Include="Fonts\segoeuii.ttf" />
    <Resource Include="Fonts\segoeuil.ttf" />
    <Resource Include="Fonts\segoeuisl.ttf" />
    <Resource Include="Fonts\segoeuiz.ttf" />
    <Resource Include="Fonts\segmdl2.ttf" />
    <EmbeddedResource Include="Localization\*.json" />
  </ItemGroup>

  <Target Name="CopyDesignIcon" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\copy-icon.ps1&quot;" />
  </Target>

</Project>
