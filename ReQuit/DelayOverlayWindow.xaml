<Window x:Class="ReQuit.DelayOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Width="1280"
        Height="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Чёрный фон: перетаскивание окна (см. code-behind). Альфа ≈ 85% -->
        <Border x:Name="DragSurface"
                Background="#D9000000"
                MouseLeftButtonDown="DragSurface_OnMouseLeftButtonDown"/>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="720"
                    Margin="40">
            <TextBlock x:Name="TitleBlock"
                       Text="{DynamicResource Loc_DelayOverlay_Title}"
                       FontSize="44"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Rs.Text.Primary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
            <TextBlock x:Name="MessageBlock"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Rs.Text.Primary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,20,0,12"
                       LineHeight="28"/>
            <TextBlock x:Name="CountdownBlock"
                       FontSize="80"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Rs.Text.Primary}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="Segoe UI"/>
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Margin="0,36,0,0">
                <Button x:Name="BtnCancel"
                        MinWidth="220"
                        Padding="24,12"
                        FontSize="15"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource Rs.Button.Success}"
                        Click="BtnCancel_OnClick"/>
                <Button x:Name="BtnConfirmNow"
                        MinWidth="220"
                        Padding="24,12"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource Rs.Button.Danger}"
                        Click="BtnConfirmNow_OnClick"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
