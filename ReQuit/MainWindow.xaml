<Window x:Class="ReQuit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ReQuit.Controls"
        Title="{DynamicResource Loc_Common_AppTitle}"
        Icon="pack://application:,,,/app.ico"
        Width="695" Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.RenderTransform>
        <ScaleTransform x:Name="TrayHideScale" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Карточка опций: геометрия всегда одна (1px обводка); в покое фон и линия прозрачные — без сдвига при hover -->
        <Style x:Key="Rs.OptionCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Card label -->
        <Style x:Key="Rs.OptionCard.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Muted}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>
        <Style x:Key="Rs.OptionCard.Label.Centered" TargetType="TextBlock" BasedOn="{StaticResource Rs.OptionCard.Label}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- «Только текст»: та же высота/ширина, что у PillTriggerMuted/PillTrigger (прозрачная рамка 1px) — без сдвига при hover карточки -->
        <Style x:Key="Rs.PillTriggerPlain" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Пилюля при наведении на карточку (не на пилюлю): серая обводка и фон -->
        <Style x:Key="Rs.PillTriggerMuted" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Rs.PillMuted.Background}"
                                BorderBrush="{DynamicResource Rs.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.PillMuted.BackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.PillMuted.Background}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Текущий выбор: акцентная пилюля (наведение на саму пилюлю, список открыт) -->
        <Style x:Key="Rs.PillTrigger" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#1A3DD4C3"
                                BorderBrush="{DynamicResource Rs.Accent}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#223DD4C3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#153DD4C3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт списка: по умолчанию серая пилюля, при наведении — акцентная -->
        <Style x:Key="Rs.PillMenuItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Rs.PillMuted.Background}"
                                BorderBrush="{DynamicResource Rs.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#223DD4C3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#153DD4C3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подложка выпадающего списка: продолжение карточки вниз -->
        <Style x:Key="Rs.PillDropdownShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Rs.OptionCard.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Rs.OptionCard.Border}"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="5,4,5,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <LinearGradientBrush x:Key="SignalEq.BarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource Rs.Color.Accent}"/>
            <GradientStop Offset="0.55" Color="{StaticResource Rs.Color.Accent}"/>
            <GradientStop Offset="1" Color="{StaticResource Rs.Color.AccentDim}"/>
        </LinearGradientBrush>

        <!-- Эквалайзер «играет мелодия»: кейфреймы + лёгкий пульс всего блока -->
        <Storyboard x:Key="SignalEqualizerStoryboard">
            <DoubleAnimation RepeatBehavior="Forever" Storyboard.TargetName="SignalEqPulse"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.06" Duration="0:0:1.75" AutoReverse="True" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation RepeatBehavior="Forever" Storyboard.TargetName="SignalEqPulse"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.06" Duration="0:0:1.75" AutoReverse="True" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation RepeatBehavior="Forever" Storyboard.TargetName="SignalEqShimmer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:0.65" AutoReverse="True" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.12"
                                           Storyboard.TargetName="SignalEqScale0" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.88">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="0.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="0.95">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.88" Value="0.26">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.12" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:0.98"
                                           Storyboard.TargetName="SignalEqScale1" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.06">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.28"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="0.72">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="0.38">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.54" Value="0.98">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="0.34">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="0.28"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.05"
                                           Storyboard.TargetName="SignalEqScale2" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.11">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.24"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.82">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.45">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="0.92">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="0.36">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.24"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.18"
                                           Storyboard.TargetName="SignalEqScale3" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.02">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.22"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="0.4">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.68" Value="0.96">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.94" Value="0.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.18" Value="0.22"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.05"
                                           Storyboard.TargetName="SignalEqScale4" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.14">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.24"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.78">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="0.42">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.84" Value="0.32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.24"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:0.98"
                                           Storyboard.TargetName="SignalEqScale5" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.08">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.28"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.68">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="0.4">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.52" Value="0.96">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.76" Value="0.36">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="0.28"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.12"
                                           Storyboard.TargetName="SignalEqScale6" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.04">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.85">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.28">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="0.92">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.86" Value="0.26">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.12" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>

    <Border Background="{DynamicResource Rs.Window.Background}"
            BorderBrush="{DynamicResource Rs.Border}"
            BorderThickness="1">
        <Grid>
        <DockPanel x:Name="MainContentRoot">
            <!-- ═══ Title bar ═══ -->
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rs.Surface}"
                    BorderBrush="{DynamicResource Rs.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="Transparent" Padding="14,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ReQuit" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="TitleBarAbout_OnMouseLeftButtonDown"/>
                                <Button Click="TitleBarAbout_OnClick"
                                        Style="{StaticResource Rs.TitleBar.AboutInfo}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Loc_MainWindow_Subtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Rs.Text.Muted}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="TitleBarLangButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            MinHeight="36"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="TitleBarLanguage_OnClick"
                            Style="{StaticResource Rs.Button}"
                            ToolTip="{DynamicResource Loc_MainWindow_LanguageTooltip}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Click="LanguageMenuItem_OnClick"
                                          Header="Русский"
                                          Tag="ru"/>
                                <MenuItem Click="LanguageMenuItem_OnClick"
                                          Header="English"
                                          Tag="en"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimizeToTray"
                                Style="{StaticResource Rs.TitleBar.Button}"
                                Content="&#x2B07;"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimizeToTray}"
                                Click="TitleBarMinimizeToTray_OnClick"/>
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource Rs.TitleBar.Button}"
                                Content="&#x2212;"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimize}"
                                Click="BtnMinimize_OnClick"/>
                        <Button x:Name="BtnClose"
                                Style="{StaticResource Rs.TitleBar.Close}"
                                Content="&#x00D7;"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipClose}"
                                Click="BtnClose_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Content ═══ -->
            <Grid Margin="30,30,30,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status text (hidden, used programmatically during delay) -->
                <TextBlock x:Name="StatusText" Grid.Row="0"
                           FontSize="15"
                           Foreground="{DynamicResource Rs.Text.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <!-- ═══ Timer display ═══ -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">

                    <controls:TimerDigitGroup x:Name="HoursDigit"
                                              MaxValue="24" UnitText=""/>

                    <TextBlock x:Name="Colon1" Text=":"
                               FontSize="68" FontWeight="Bold"
                               Foreground="{DynamicResource Rs.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               Opacity="0.5"/>

                    <controls:TimerDigitGroup x:Name="MinutesDigit"
                                              MaxValue="59" UnitText=""/>

                    <TextBlock x:Name="Colon2" Text=":"
                               FontSize="68" FontWeight="Bold"
                               Foreground="{DynamicResource Rs.Text.Muted}"
                               VerticalAlignment="Center"
                               Margin="8,0,8,0"
                               Opacity="0.5"/>

                    <controls:TimerDigitGroup x:Name="SecondsDigit"
                                              MaxValue="59" UnitText=""/>
                </StackPanel>

                <!-- ═══ Bottom: action + start + delay ═══ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Left: Action selector (одна пилюля + выпадающий список) ── -->
                    <Border x:Name="ActionOptionCard"
                            Grid.Column="0"
                            Style="{StaticResource Rs.OptionCard}"
                            MouseEnter="ActionOptionCard_OnMouseEnter"
                            MouseLeave="ActionOptionCard_OnMouseLeave">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_MainWindow_ActionAfterExpiry}"
                                       Style="{StaticResource Rs.OptionCard.Label.Centered}"/>
                            <Button x:Name="ActionPillTrigger"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Rs.PillTriggerPlain}"
                                    MouseEnter="ActionPill_OnMouseEnter"
                                    MouseLeave="ActionPill_OnMouseLeave">
                                <TextBlock x:Name="ActionPillText"
                                           Text="{DynamicResource Loc_MainWindow_ActionShutdown}"
                                           TextAlignment="Center"/>
                            </Button>
                            <Popup x:Name="ActionPopup"
                                   PlacementTarget="{Binding ElementName=ActionOptionCard}"
                                   Placement="Bottom"
                                   VerticalOffset="-1"
                                   HorizontalOffset="0"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   PopupAnimation="Fade">
                                <Border Style="{StaticResource Rs.PillDropdownShell}"
                                        Width="{Binding ActualWidth, ElementName=ActionOptionCard}"
                                        MouseEnter="ActionPopupSurface_OnMouseEnter"
                                        MouseLeave="ActionPopupSurface_OnMouseLeave">
                                    <StackPanel>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_ActionShutdown}"
                                                Click="ActionPickShutdown_OnClick"/>
                                        <Button Margin="0"
                                                Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_ActionSignal}"
                                                Click="ActionPickSignal_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <!-- ── Center: Start / Stop ── -->
                    <Button x:Name="BtnStartStop" Grid.Column="1"
                            Content="{DynamicResource Loc_MainWindow_BtnStart}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="200" Padding="24,12"
                            FontSize="15"
                            IsEnabled="False"
                            Style="{StaticResource Rs.Button.Accent}"
                            RenderTransformOrigin="0.5,0.5"
                            Click="BtnStartStop_OnClick"
                            MouseRightButtonDown="BtnStartStop_OnMouseRightButtonDown">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                    </Button>

                    <!-- ── Right: Delay selector (одна пилюля + выпадающий список) ── -->
                    <Border x:Name="DelayOptionCard"
                            Grid.Column="2"
                            Style="{StaticResource Rs.OptionCard}"
                            MouseEnter="DelayOptionCard_OnMouseEnter"
                            MouseLeave="DelayOptionCard_OnMouseLeave">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Rs.OptionCard.Label.Centered}"
                                       Text="{DynamicResource Loc_MainWindow_DelayLabel}"/>
                            <Button x:Name="DelayPillTrigger"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Rs.PillTriggerPlain}"
                                    MouseEnter="DelayPill_OnMouseEnter"
                                    MouseLeave="DelayPill_OnMouseLeave">
                                <TextBlock x:Name="DelayPillText"
                                           Text="{DynamicResource Loc_MainWindow_Delay1m}"
                                           TextAlignment="Center"/>
                            </Button>
                            <Popup x:Name="DelayPopup"
                                   PlacementTarget="{Binding ElementName=DelayOptionCard}"
                                   Placement="Bottom"
                                   VerticalOffset="-1"
                                   HorizontalOffset="0"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   PopupAnimation="Fade">
                                <Border Style="{StaticResource Rs.PillDropdownShell}"
                                        Width="{Binding ActualWidth, ElementName=DelayOptionCard}"
                                        MouseEnter="DelayPopupSurface_OnMouseEnter"
                                        MouseLeave="DelayPopupSurface_OnMouseLeave">
                                    <StackPanel>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_DelayNone}"
                                                Tag="0" Click="DelayPick_OnClick"/>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_Delay30s}"
                                                Tag="30" Click="DelayPick_OnClick"/>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_Delay1m}"
                                                Tag="60" Click="DelayPick_OnClick"/>
                                        <Button Margin="0"
                                                Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_Delay5m}"
                                                Tag="300" Click="DelayPick_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
        <!-- Отсрочка / сигнал: размытие MainContentRoot + 50% чёрная плёнка, блокировка кликов -->
        <Grid x:Name="DelayPhaseMainDimmer"
              Visibility="Collapsed"
              Focusable="True"
              Background="Transparent">
            <Border IsHitTestVisible="False"
                    SnapsToDevicePixels="True">
                <Border.Background>
                    <VisualBrush Visual="{Binding ElementName=MainContentRoot}"
                                 Stretch="UniformToFill"
                                 AlignmentX="Center"
                                 AlignmentY="Center"/>
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="96"
                                KernelType="Gaussian"
                                RenderingBias="Quality"/>
                </Border.Effect>
            </Border>
            <!-- ~80% непрозрачность чёрного; перетаскивание окна за эту плёнку -->
            <Border Background="#CC000000"
                    IsHitTestVisible="True"
                    MouseLeftButtonDown="DelayPhaseMainDimmerDark_OnMouseLeftButtonDown"/>
        </Grid>
        <!-- Сигнал сработал: плёнка уже включена, сверху текст и «Ок» -->
        <Grid x:Name="SignalFinishedOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              IsHitTestVisible="True"
              MouseLeftButtonDown="SignalFinishedOverlay_OnMouseLeftButtonDown">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="520">
                <!-- Эквалайзер: градиент, подсветка, кейфреймы в Storyboard -->
                <Grid x:Name="SignalEqVisualizer"
                      Margin="0,0,0,20"
                      HorizontalAlignment="Center"
                      RenderTransformOrigin="0.5,0.62"
                      SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SignalEqPulse" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                        <Ellipse x:Name="SignalEqShimmer"
                                 Width="178" Height="42"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,2"
                                 IsHitTestVisible="False"
                                 Opacity="0.52">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.62" RadiusY="0.92">
                                    <GradientStop Offset="0.08" Color="#663DD4C3"/>
                                    <GradientStop Offset="1" Color="#00000000"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Grid Width="176" Height="50" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale0" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="1" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale1" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="2" Width="11" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale2" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="3" Width="12" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale3" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="4" Width="11" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale4" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="5" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale5" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="6" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale6" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                </Grid>
                <TextBlock Text="{DynamicResource Loc_MainWindow_SignalFinishedMessage}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Rs.Text.Primary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,24"/>
                <Button x:Name="BtnSignalFinishedOk"
                        MinWidth="200"
                        Padding="24,12"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Rs.Button.Accent}"
                        Content="{DynamicResource Loc_MainWindow_SignalFinishedOk}"
                        Click="BtnSignalFinishedOk_OnClick"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
