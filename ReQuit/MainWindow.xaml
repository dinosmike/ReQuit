<Window x:Class="ReQuit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ReQuit.Controls"
        Title="{DynamicResource Loc_Common_AppTitle}"
        Icon="pack://application:,,,/app.ico"
        Width="695" Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.RenderTransform>
        <ScaleTransform x:Name="TrayHideScale" ScaleX="1" ScaleY="1"/>
    </Window.RenderTransform>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Geometry x:Key="Rs.Icon.Shutdown.SvgPath">M13 0a2 2 0 0 0-2 2v10a2 2 0 0 0 4 0V2a2 2 0 0 0-2-2zM5.844 2.594a1.5 1.5 0 0 0-.782.344A12.796 12.796 0 0 0 .188 13C.188 20.058 5.94 25.813 13 25.813S25.813 20.058 25.813 13c0-4.073-1.902-7.717-4.875-10.063a1.5 1.5 0 1 0-1.875 2.344A9.804 9.804 0 0 1 22.813 13A9.789 9.789 0 0 1 13 22.813A9.789 9.789 0 0 1 3.187 13a9.808 9.808 0 0 1 3.75-7.719a1.5 1.5 0 0 0-1.093-2.687z</Geometry>
        <Geometry x:Key="Rs.Icon.Bell.SvgPath">M8 16a2 2 0 0 0 1.985-1.75c.017-.137-.097-.25-.235-.25h-3.5c-.138 0-.252.113-.235.25A2 2 0 0 0 8 16ZM3 5a5 5 0 0 1 10 0v2.947c0 .05.015.098.042.139l1.703 2.555A1.519 1.519 0 0 1 13.482 13H2.518a1.516 1.516 0 0 1-1.263-2.36l1.703-2.554A.255.255 0 0 0 3 7.947Zm5-3.5A3.5 3.5 0 0 0 4.5 5v2.947c0 .346-.102.683-.294.97l-1.703 2.556a.017.017 0 0 0-.003.01l.001.006c0 .002.002.004.004.006l.006.004l.007.001h10.964l.007-.001l.006-.004l.004-.006l.001-.007a.017.017 0 0 0-.003-.01l-1.703-2.554a1.745 1.745 0 0 1-.294-.97V5A3.5 3.5 0 0 0 8 1.5Z</Geometry>

        <!-- Карточка опций: геометрия всегда одна (1px обводка); в покое фон и линия прозрачные — без сдвига при hover -->
        <Style x:Key="Rs.OptionCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Card label -->
        <Style x:Key="Rs.OptionCard.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Muted}"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>
        <Style x:Key="Rs.OptionCard.Label.Centered" TargetType="TextBlock" BasedOn="{StaticResource Rs.OptionCard.Label}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- «Только текст»: та же высота/ширина, что у PillTriggerMuted/PillTrigger (прозрачная рамка 1px) — без сдвига при hover карточки -->
        <Style x:Key="Rs.PillTriggerPlain" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Пилюля при наведении на карточку (не на пилюлю): серая обводка и фон -->
        <Style x:Key="Rs.PillTriggerMuted" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Rs.PillMuted.Background}"
                                BorderBrush="{DynamicResource Rs.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.PillMuted.BackgroundHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.PillMuted.Background}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Текущий выбор: акцентная пилюля (наведение на саму пилюлю, список открыт) -->
        <Style x:Key="Rs.PillTrigger" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#1A3DD4C3"
                                BorderBrush="{DynamicResource Rs.Accent}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#223DD4C3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#153DD4C3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт списка: по умолчанию серая пилюля, при наведении — акцентная -->
        <Style x:Key="Rs.PillMenuItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Rs.PillMuted.Background}"
                                BorderBrush="{DynamicResource Rs.Border}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#223DD4C3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#153DD4C3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подложка выпадающего списка: продолжение карточки вниз -->
        <Style x:Key="Rs.PillDropdownShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Rs.OptionCard.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Rs.OptionCard.Border}"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="CornerRadius" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="5,4,5,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <LinearGradientBrush x:Key="SignalEq.BarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="{StaticResource Rs.Color.Accent}"/>
            <GradientStop Offset="0.55" Color="{StaticResource Rs.Color.Accent}"/>
            <GradientStop Offset="1" Color="{StaticResource Rs.Color.AccentDim}"/>
        </LinearGradientBrush>

        <!-- Эквалайзер «играет мелодия»: кейфреймы + лёгкий пульс всего блока -->
        <Storyboard x:Key="SignalEqualizerStoryboard">
            <DoubleAnimation RepeatBehavior="Forever" Storyboard.TargetName="SignalEqPulse"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.06" Duration="0:0:1.75" AutoReverse="True" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation RepeatBehavior="Forever" Storyboard.TargetName="SignalEqPulse"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.06" Duration="0:0:1.75" AutoReverse="True" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation RepeatBehavior="Forever" Storyboard.TargetName="SignalEqShimmer"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:0.65" AutoReverse="True" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.12"
                                           Storyboard.TargetName="SignalEqScale0" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.88">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="0.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.62" Value="0.95">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.88" Value="0.26">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.12" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:0.98"
                                           Storyboard.TargetName="SignalEqScale1" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.06">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.28"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="0.72">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.36" Value="0.38">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.54" Value="0.98">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.78" Value="0.34">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="0.28"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.05"
                                           Storyboard.TargetName="SignalEqScale2" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.11">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.24"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.82">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.45">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="0.92">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="0.36">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.24"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.18"
                                           Storyboard.TargetName="SignalEqScale3" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.02">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.22"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="0.4">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.68" Value="0.96">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.94" Value="0.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.18" Value="0.22"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.05"
                                           Storyboard.TargetName="SignalEqScale4" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.14">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.24"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="0.78">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="0.42">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0.9">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.84" Value="0.32">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0.24"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:0.98"
                                           Storyboard.TargetName="SignalEqScale5" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.08">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.28"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="0.68">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.34" Value="0.4">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.52" Value="0.96">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.76" Value="0.36">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:0.98" Value="0.28"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames RepeatBehavior="Forever" Duration="0:0:1.12"
                                           Storyboard.TargetName="SignalEqScale6" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.04">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="0.85">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="0.28">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="0.92">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.86" Value="0.26">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseIn"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <LinearDoubleKeyFrame KeyTime="0:0:1.12" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Монитор ресурсов: сканирующая полоса + лёгкий пульс линии графика -->
        <Storyboard x:Key="ResourceSparkScanStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ResourceSparkScan"
                             Storyboard.TargetProperty="(Canvas.Left)"
                             From="-40" To="300" Duration="0:0:2.35">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ResourceSparklinePulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ResourceSparkline"
                             Storyboard.TargetProperty="Opacity"
                             From="0.65" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Монитор ресурсов: пульс «бликом» по полосе подтверждения условия -->
        <Storyboard x:Key="ResourceConfirmPulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ResourceConditionConfirmPulse"
                             Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="0.62" Duration="0:0:0.30" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ResourceConditionConfirmPulseBrushTransform"
                             Storyboard.TargetProperty="X"
                             From="-1" To="1" Duration="0:0:1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border Background="{DynamicResource Rs.Window.Background}"
            BorderBrush="{DynamicResource Rs.Border}"
            BorderThickness="1">
        <Grid>
        <DockPanel x:Name="MainContentRoot">
            <!-- ═══ Title bar ═══ -->
            <Border DockPanel.Dock="Top" Height="44"
                    Background="{DynamicResource Rs.Surface}"
                    BorderBrush="{DynamicResource Rs.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="Transparent" Padding="14,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ReQuit" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Bottom"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="TitleBarAbout_OnMouseLeftButtonDown"/>
                                <Button Click="TitleBarAbout_OnClick"
                                        Style="{StaticResource Rs.TitleBar.AboutInfo}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Loc_MainWindow_Subtitle}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Rs.Text.Muted}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="TitleBarMenuButton"
                                Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Style="{StaticResource Rs.TitleBar.Button}"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMenu}"
                                Click="TitleBarMenu_OnClick">
                            <Grid Width="14" Height="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Height="2" CornerRadius="1" Background="{DynamicResource Rs.Text.Primary}" VerticalAlignment="Center"/>
                                <Border Grid.Row="1" Height="2" CornerRadius="1" Background="{DynamicResource Rs.Text.Primary}" VerticalAlignment="Center"/>
                                <Border Grid.Row="2" Height="2" CornerRadius="1" Background="{DynamicResource Rs.Text.Primary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Button x:Name="TitleBarLangButton"
                                MinHeight="36"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Click="TitleBarLanguage_OnClick"
                                Style="{StaticResource Rs.Button}"
                                ToolTip="{DynamicResource Loc_MainWindow_LanguageTooltip}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="LanguageMenuItem_OnClick"
                                              Header="Русский"
                                              Tag="ru"/>
                                    <MenuItem Click="LanguageMenuItem_OnClick"
                                              Header="English"
                                              Tag="en"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnMinimizeToTray"
                                Style="{StaticResource Rs.TitleBar.Button}"
                                Content="&#x2B07;"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimizeToTray}"
                                Click="TitleBarMinimizeToTray_OnClick"/>
                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource Rs.TitleBar.Button}"
                                Content="&#x2212;"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipMinimize}"
                                Click="BtnMinimize_OnClick"/>
                        <Button x:Name="BtnClose"
                                Style="{StaticResource Rs.TitleBar.Close}"
                                Content="&#x00D7;"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipClose}"
                                Click="BtnClose_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Content ═══ -->
            <Grid Margin="30,30,30,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status text (hidden, used programmatically during delay) -->
                <TextBlock x:Name="StatusText" Grid.Row="0"
                           FontSize="15"
                           Foreground="{DynamicResource Rs.Text.Muted}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <!-- ═══ Timer display / монитор ресурсов (оверлей того же размера) ═══ -->
                <Grid Grid.Row="1"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">
                    <StackPanel x:Name="MainTimerStack"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,20,0,0">

                        <controls:TimerDigitGroup x:Name="HoursDigit"
                                                  MaxValue="24" UnitText=""
                                                  UnitLabelOffsetY="-23"/>

                        <TextBlock x:Name="Colon1" Text=":"
                                   FontSize="68" FontWeight="Bold"
                                   Foreground="{DynamicResource Rs.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,8,0"
                                   Opacity="0.5"/>

                        <controls:TimerDigitGroup x:Name="MinutesDigit"
                                                  MaxValue="59" UnitText=""
                                                  UnitLabelOffsetY="-23"/>

                        <TextBlock x:Name="Colon2" Text=":"
                                   FontSize="68" FontWeight="Bold"
                                   Foreground="{DynamicResource Rs.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,8,0"
                                   Opacity="0.5"/>

                        <controls:TimerDigitGroup x:Name="SecondsDigit"
                                                  MaxValue="59" UnitText=""
                                                  UnitLabelOffsetY="-23"/>
                    </StackPanel>

                    <Grid x:Name="ResourceMonitorOverlay"
                          Visibility="Collapsed"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource Rs.Window.Background}">
                        <Grid x:Name="ResourceMonitorContent"
                              Panel.ZIndex="0"
                              Margin="0,-40,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Loc_MainWindow_ResourceConditionTitle}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Rs.Text.Primary}"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="40,0,40,0"/>
                                <Button x:Name="BtnResourceMonitorClose"
                                        Width="36"
                                        Height="36"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-6,-8,-6"
                                        Padding="0"
                                        FontSize="15"
                                        Style="{StaticResource Rs.TitleBar.Close.Round}"
                                        Content="&#x00D7;"
                                        ToolTip="{DynamicResource Loc_MainWindow_TooltipClose}"
                                        Click="BtnResourceMonitorClose_OnClick"/>
                            </Grid>
                            <StackPanel Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        MaxWidth="620"
                                        Margin="0,0,0,4">
                                <WrapPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="ResourceConditionIfText"
                                               FontSize="13"
                                               Foreground="{DynamicResource Rs.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,6"
                                               TextWrapping="Wrap"/>
                                    <ComboBox x:Name="ResourceKindCombo"
                                              MinWidth="150"
                                              MaxWidth="400"
                                              Margin="0,0,8,6"
                                              VerticalAlignment="Center"
                                              SelectionChanged="ResourceKindCombo_OnSelectionChanged"/>
                                    <TextBlock x:Name="ResourceConditionDropsText"
                                               FontSize="13"
                                               Foreground="{DynamicResource Rs.Text.Muted}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,6"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="ResourceThresholdTextBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource Rs.TextBox.ResourceThreshold}"
                                                     VerticalAlignment="Stretch"
                                                     MinHeight="32"
                                                     LostFocus="ResourceThresholdTextBox_OnLostFocus"
                                                     KeyDown="ResourceThresholdTextBox_OnKeyDown"/>
                                            <Border Grid.Column="1"
                                                    BorderBrush="{DynamicResource Rs.Border}"
                                                    BorderThickness="1"
                                                    Width="24"
                                                    MinHeight="32"
                                                    VerticalAlignment="Stretch"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="1"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <RepeatButton x:Name="ResourceThresholdUpButton"
                                                                  Grid.Row="0"
                                                                  Style="{StaticResource Rs.RepeatButton.ResourceSpinner}"
                                                                  Delay="350"
                                                                  Interval="80"
                                                                  Click="ResourceThresholdUpButton_OnClick"
                                                                  Content="&#x25B2;"
                                                                  ToolTip="{DynamicResource Loc_MainWindow_ResourceThresholdUp}"/>
                                                    <Border Grid.Row="1" Background="{DynamicResource Rs.Border}" Height="1"/>
                                                    <RepeatButton x:Name="ResourceThresholdDownButton"
                                                                  Grid.Row="2"
                                                                  Style="{StaticResource Rs.RepeatButton.ResourceSpinner}"
                                                                  Delay="350"
                                                                  Interval="80"
                                                                  Click="ResourceThresholdDownButton_OnClick"
                                                                  Content="&#x25BC;"
                                                                  ToolTip="{DynamicResource Loc_MainWindow_ResourceThresholdDown}"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="%"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Rs.Text.Muted}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                            <Border Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,10"
                                    Width="288"
                                    Height="104"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource Rs.Border}"
                                    BorderThickness="1"
                                    Background="{DynamicResource Rs.Surface}"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="5,4">
                                    <Canvas x:Name="ResourceSparkCanvas"
                                            Width="276"
                                            Height="80"
                                            ClipToBounds="True"
                                            SnapsToDevicePixels="True">
                                        <Rectangle x:Name="ResourceSparkScan"
                                                   Canvas.Left="-40"
                                                   Canvas.Top="0"
                                                   Width="42"
                                                   Height="80"
                                                   RadiusX="3" RadiusY="3"
                                                   Fill="#183DD4C3"
                                                   IsHitTestVisible="False"/>
                                        <Polyline x:Name="ResourceSparkline"
                                                  Opacity="0.92"
                                                  Stroke="{DynamicResource Rs.Accent}"
                                                  StrokeThickness="1.75"
                                                  StrokeLineJoin="Round"
                                                  StrokeEndLineCap="Round"
                                                  SnapsToDevicePixels="True"/>
                                    </Canvas>

                                    <!-- Подтверждение условия (20 секунд) -->
                                    <Grid x:Name="ResourceConditionConfirmOverlay"
                                          Visibility="Collapsed"
                                          Panel.ZIndex="20"
                                          Background="#B0000000">
                                        <Border Background="{DynamicResource Rs.Surface}"
                                                BorderBrush="{DynamicResource Rs.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="252">
                                            <StackPanel>
                                                <TextBlock x:Name="ResourceConditionConfirmText"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource Rs.Text.Primary}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6"/>
                                                <TextBlock x:Name="ResourceConditionConfirmSubText"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Rs.Text.Muted}"
                                                           TextAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,8"/>
                                                <Grid ClipToBounds="True">
                                                    <ProgressBar x:Name="ResourceConditionConfirmProgress"
                                                                 Height="8"
                                                                 Minimum="0"
                                                                 Maximum="1"
                                                                 Value="0"
                                                                 Foreground="{DynamicResource Rs.Accent.Confirm}"
                                                                 Background="#252B33"/>
                                                    <Rectangle x:Name="ResourceConditionConfirmPulse"
                                                               Height="8"
                                                               IsHitTestVisible="False"
                                                               Opacity="0"
                                                               RadiusX="4" RadiusY="4"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Center">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush x:Name="ResourceConditionConfirmPulseBrush"
                                                                                 StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="0.40"/>
                                                                <GradientStop Color="#E6FFFFFF" Offset="0.50"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="0.60"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                <LinearGradientBrush.RelativeTransform>
                                                                    <TranslateTransform x:Name="ResourceConditionConfirmPulseBrushTransform" X="-1"/>
                                                                </LinearGradientBrush.RelativeTransform>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ResourceLiveSelectedText"
                                       Grid.Row="3"
                                       FontSize="12"
                                       Foreground="{DynamicResource Rs.Text.Primary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                            <TextBlock x:Name="ResourceWaitStatusText"
                                       Grid.Row="4"
                                       FontSize="13"
                                       Foreground="#0cb37a"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                            <CheckBox x:Name="ResourceTakeScreenshotCheckBox"
                                      Grid.Row="5"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,0"
                                      Style="{StaticResource Rs.CheckBox}"
                                      Content="{DynamicResource Loc_MainWindow_ResourceTakeScreenshot}"
                                      Checked="ResourceTakeScreenshotCheckBox_OnChecked"
                                      Unchecked="ResourceTakeScreenshotCheckBox_OnChecked"/>
                        </Grid>

                        <Grid x:Name="ResourceMonitorLoadingOverlay"
                              Visibility="Collapsed"
                              Panel.ZIndex="10"
                              Margin="0,-40,0,0"
                              Background="{DynamicResource Rs.Window.Background}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="30,20"
                                        MaxWidth="520">
                                <TextBlock x:Name="ResourceMonitorLoadingText"
                                           FontSize="14"
                                           Foreground="{DynamicResource Rs.Text.Primary}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <ProgressBar Width="260"
                                             Height="8"
                                             IsIndeterminate="True"
                                             Foreground="{DynamicResource Rs.Accent}"
                                             Background="#252B33"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ═══ Bottom: action + start + delay ═══ -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Left: Action selector (одна пилюля + выпадающий список) ── -->
                    <Border x:Name="ActionOptionCard"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource Rs.OptionCard}"
                            MouseEnter="ActionOptionCard_OnMouseEnter"
                            MouseLeave="ActionOptionCard_OnMouseLeave">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_MainWindow_ActionAfterExpiry}"
                                       Style="{StaticResource Rs.OptionCard.Label.Centered}"/>
                            <Button x:Name="ActionPillTrigger"
                                    HorizontalAlignment="Center"
                                    MinWidth="100"
                                    Style="{StaticResource Rs.PillTriggerPlain}"
                                    MouseEnter="ActionPill_OnMouseEnter"
                                    MouseLeave="ActionPill_OnMouseLeave">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="12"
                                          Height="12"
                                          Margin="0,0,5,0"
                                          VerticalAlignment="Center"
                                          SnapsToDevicePixels="True"
                                          ClipToBounds="True"
                                          UseLayoutRounding="True">
                                        <Viewbox x:Name="ActionPillIconShutdown"
                                                 Width="12" Height="12"
                                                 Stretch="Uniform"
                                                 SnapsToDevicePixels="True"
                                                 UseLayoutRounding="True"
                                                 IsHitTestVisible="False">
                                            <Canvas Width="26" Height="26">
                                                <Path Data="{StaticResource Rs.Icon.Shutdown.SvgPath}"
                                                      Fill="#555555"/>
                                            </Canvas>
                                        </Viewbox>
                                        <Viewbox x:Name="ActionPillIconSignal"
                                                 Width="12" Height="12"
                                                 Stretch="Uniform"
                                                 SnapsToDevicePixels="True"
                                                 UseLayoutRounding="True"
                                                 Visibility="Collapsed"
                                                 IsHitTestVisible="False">
                                            <Canvas Width="16" Height="16">
                                                <Path Data="{StaticResource Rs.Icon.Bell.SvgPath}"
                                                      Fill="#555555"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock x:Name="ActionPillText"
                                               Text="{DynamicResource Loc_MainWindow_ActionShutdown}"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Popup x:Name="ActionPopup"
                                   PlacementTarget="{Binding ElementName=ActionOptionCard}"
                                   Placement="Bottom"
                                   VerticalOffset="-1"
                                   HorizontalOffset="0"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   PopupAnimation="Fade">
                                <Border Style="{StaticResource Rs.PillDropdownShell}"
                                        Width="{Binding ActualWidth, ElementName=ActionOptionCard}"
                                        MouseEnter="ActionPopupSurface_OnMouseEnter"
                                        MouseLeave="ActionPopupSurface_OnMouseLeave">
                                    <StackPanel>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Click="ActionPickShutdown_OnClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Stretch="Uniform"
                                                         SnapsToDevicePixels="True"
                                                         UseLayoutRounding="True">
                                                    <Canvas Width="26" Height="26">
                                                        <Path Data="{StaticResource Rs.Icon.Shutdown.SvgPath}"
                                                              Fill="#555555"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{DynamicResource Loc_MainWindow_ActionShutdown}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Margin="0"
                                                Style="{StaticResource Rs.PillMenuItem}"
                                                Click="ActionPickSignal_OnClick">
                                            <StackPanel Orientation="Horizontal">
                                                <Viewbox Width="12" Height="12" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Stretch="Uniform"
                                                         SnapsToDevicePixels="True"
                                                         UseLayoutRounding="True">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Data="{StaticResource Rs.Icon.Bell.SvgPath}"
                                                              Fill="#555555"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{DynamicResource Loc_MainWindow_ActionSignal}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <!-- ── Center: Start / Stop ── -->
                    <Button x:Name="BtnStartStop" Grid.Column="1"
                            Content="{DynamicResource Loc_MainWindow_BtnStart}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="200" Padding="24,12"
                            FontSize="15"
                            IsEnabled="False"
                            Style="{StaticResource Rs.Button.Accent}"
                            RenderTransformOrigin="0.5,0.5"
                            Click="BtnStartStop_OnClick"
                            MouseRightButtonDown="BtnStartStop_OnMouseRightButtonDown"
                            MouseDown="BtnStartStop_OnMouseDown">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                    </Button>

                    <!-- ── Right: Delay selector (одна пилюля + выпадающий список) ── -->
                    <Border x:Name="DelayOptionCard"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource Rs.OptionCard}"
                            MouseEnter="DelayOptionCard_OnMouseEnter"
                            MouseLeave="DelayOptionCard_OnMouseLeave">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Rs.OptionCard.Label.Centered}"
                                       Text="{DynamicResource Loc_MainWindow_DelayLabel}"/>
                            <Button x:Name="DelayPillTrigger"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource Rs.PillTriggerPlain}"
                                    MouseEnter="DelayPill_OnMouseEnter"
                                    MouseLeave="DelayPill_OnMouseLeave">
                                <TextBlock x:Name="DelayPillText"
                                           Text="{DynamicResource Loc_MainWindow_Delay1m}"
                                           TextAlignment="Center"/>
                            </Button>
                            <Popup x:Name="DelayPopup"
                                   PlacementTarget="{Binding ElementName=DelayOptionCard}"
                                   Placement="Bottom"
                                   VerticalOffset="-1"
                                   HorizontalOffset="0"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   PopupAnimation="Fade">
                                <Border Style="{StaticResource Rs.PillDropdownShell}"
                                        Width="{Binding ActualWidth, ElementName=DelayOptionCard}"
                                        MouseEnter="DelayPopupSurface_OnMouseEnter"
                                        MouseLeave="DelayPopupSurface_OnMouseLeave">
                                    <StackPanel>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_DelayNone}"
                                                Tag="0" Click="DelayPick_OnClick"/>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_Delay30s}"
                                                Tag="30" Click="DelayPick_OnClick"/>
                                        <Button Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_Delay1m}"
                                                Tag="60" Click="DelayPick_OnClick"/>
                                        <Button Margin="0"
                                                Style="{StaticResource Rs.PillMenuItem}"
                                                Content="{DynamicResource Loc_MainWindow_Delay5m}"
                                                Tag="300" Click="DelayPick_OnClick"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DockPanel>
        <!-- Отсрочка / сигнал: размытие MainContentRoot + 50% чёрная плёнка, блокировка кликов -->
        <Grid x:Name="DelayPhaseMainDimmer"
              Visibility="Collapsed"
              Focusable="True"
              Background="Transparent">
            <Border IsHitTestVisible="False"
                    SnapsToDevicePixels="True">
                <Border.Background>
                    <VisualBrush Visual="{Binding ElementName=MainContentRoot}"
                                 Stretch="UniformToFill"
                                 AlignmentX="Center"
                                 AlignmentY="Center"/>
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="96"
                                KernelType="Gaussian"
                                RenderingBias="Quality"/>
                </Border.Effect>
            </Border>
            <!-- ~80% непрозрачность чёрного; перетаскивание окна за эту плёнку -->
            <Border Background="#CC000000"
                    IsHitTestVisible="True"
                    MouseLeftButtonDown="DelayPhaseMainDimmerDark_OnMouseLeftButtonDown"/>
        </Grid>
        <!-- Точное время: затемнение/размытие — общий слой DelayPhaseMainDimmer; поверх — мини-циферблат -->
        <Grid x:Name="ExactTimeOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              IsHitTestVisible="True"
              MouseLeftButtonDown="ExactTimeOverlay_OnMouseLeftButtonDown">
            <Border x:Name="ExactTimeDialogRoot"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Rs.Window.Background}"
                    BorderBrush="{DynamicResource Rs.OptionCard.Border}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,14,14,20"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource Loc_MainWindow_ExactTimeTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Rs.Text.Primary}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="36,0,36,0"/>
                        <Button x:Name="BtnExactTimeClose"
                                Width="36"
                                Height="36"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-4,-6,-4"
                                Padding="0"
                                FontSize="15"
                                Style="{StaticResource Rs.TitleBar.Close.Round}"
                                Content="&#x00D7;"
                                ToolTip="{DynamicResource Loc_MainWindow_TooltipClose}"
                                Click="BtnExactTimeClose_OnClick"/>
                    </Grid>
                    <Viewbox Grid.Row="1"
                             Stretch="Uniform"
                             MaxWidth="400"
                             MaxHeight="200"
                             HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <controls:TimerDigitGroup x:Name="ExactTimeHours"
                                                      MaxValue="23"
                                                      UnitText=""
                                                      Width="175"
                                                      UnitLabelOffsetY="-5"/>
                            <TextBlock Text=":"
                                       FontSize="68"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Rs.Text.Muted}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,8,0"
                                       Opacity="0.5"/>
                            <controls:TimerDigitGroup x:Name="ExactTimeMinutes"
                                                      MaxValue="59"
                                                      UnitText=""
                                                      Width="175"
                                                      UnitLabelOffsetY="-5"/>
                        </StackPanel>
                    </Viewbox>
                    <Button x:Name="BtnExactTimeStart"
                            Grid.Row="2"
                            Margin="0,18,0,0"
                            MinWidth="220"
                            Padding="24,12"
                            FontSize="15"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Rs.Button.Accent}"
                            Content="{DynamicResource Loc_MainWindow_ExactTimeStartTimer}"
                            Click="BtnExactTimeStart_OnClick"
                            IsDefault="True"/>
                </Grid>
            </Border>
        </Grid>
        <!-- Сигнал сработал: плёнка уже включена, сверху текст и «Ок» -->
        <Grid x:Name="SignalFinishedOverlay"
              Visibility="Collapsed"
              Background="Transparent"
              IsHitTestVisible="True"
              MouseLeftButtonDown="SignalFinishedOverlay_OnMouseLeftButtonDown">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="520">
                <!-- Эквалайзер: градиент, подсветка, кейфреймы в Storyboard -->
                <Grid x:Name="SignalEqVisualizer"
                      Margin="0,0,0,20"
                      HorizontalAlignment="Center"
                      RenderTransformOrigin="0.5,0.62"
                      SnapsToDevicePixels="True">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="SignalEqPulse" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                        <Ellipse x:Name="SignalEqShimmer"
                                 Width="178" Height="42"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,2"
                                 IsHitTestVisible="False"
                                 Opacity="0.52">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.5,1" Center="0.5,1" RadiusX="0.62" RadiusY="0.92">
                                    <GradientStop Offset="0.08" Color="#663DD4C3"/>
                                    <GradientStop Offset="1" Color="#00000000"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Grid Width="176" Height="50" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale0" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="1" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale1" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="2" Width="11" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale2" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="3" Width="12" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale3" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="4" Width="11" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale4" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="5" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Margin="0,0,3,0"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale5" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Grid.Column="6" Width="10" Height="46" CornerRadius="4" VerticalAlignment="Bottom"
                                    Background="{StaticResource SignalEq.BarGradient}"
                                    RenderTransformOrigin="0.5,1"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SignalEqScale6" ScaleX="1" ScaleY="0.32"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                </Grid>
                <TextBlock Text="{DynamicResource Loc_MainWindow_SignalFinishedMessage}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Rs.Text.Primary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,24"/>
                <Button x:Name="BtnSignalFinishedOk"
                        MinWidth="200"
                        Padding="24,12"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        Style="{StaticResource Rs.Button.Accent}"
                        Content="{DynamicResource Loc_MainWindow_SignalFinishedOk}"
                        Click="BtnSignalFinishedOk_OnClick"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
