<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
                    xmlns:net="clr-namespace:System;assembly=System.Runtime">

    <!-- Встроенные TTF; здесь же, чтобы StaticResource в стилях/шаблонах находил ключи -->
    <FontFamily x:Key="Rs.Font.Ui">pack://application:,,,/Fonts/#Segoe UI</FontFamily>
    <FontFamily x:Key="Rs.Font.Mdl2">pack://application:,,,/Fonts/segmdl2.ttf#Segoe MDL2 Assets</FontFamily>

    <Color x:Key="Rs.Color.Background">#0D1117</Color>
    <Color x:Key="Rs.Color.Surface">#161B22</Color>
    <Color x:Key="Rs.Color.Border">#30363D</Color>
    <Color x:Key="Rs.Color.TextPrimary">#E6EDF3</Color>
    <Color x:Key="Rs.Color.TextMuted">#8B949E</Color>
    <!-- Более тёмный muted для неактивных/второстепенных подписей -->
    <Color x:Key="Rs.Color.TextMutedDim">#66707A</Color>
    <Color x:Key="Rs.Color.Accent">#3DD4C3</Color>
    <Color x:Key="Rs.Color.AccentDim">#1F6F65</Color>
    <!-- Цвет подтверждения условия в мониторе ресурсов (прогрессбар «Условие выполняется…»). -->
    <Color x:Key="Rs.Color.AccentConfirm">#00ae4e</Color>
    <Color x:Key="Rs.Color.Danger">#F85149</Color>
    <Color x:Key="Rs.Color.DangerDim">#5C1E24</Color>
    <!-- Непрозрачный аналог #10FFFFFF поверх Rs.Color.Background (единая подложка карточки опций) -->
    <Color x:Key="Rs.Color.OptionCard">#1C2026</Color>
    <!-- Пилюля при наведении только на карточку (серая, не акцентная) -->
    <Color x:Key="Rs.Color.PillMutedFill">#252B33</Color>
    <!-- Иконки действий: Segoe MDL2 Assets из Fonts/segmdl2.ttf -->
    <Color x:Key="Rs.Color.ProfileActionIcon">#3DD4C3</Color>
    <SolidColorBrush x:Key="Rs.ProfileAction.IconBrush" Color="{StaticResource Rs.Color.ProfileActionIcon}"/>
    <net:Double x:Key="Rs.ProfileAction.IconSize">12</net:Double>

    <SolidColorBrush x:Key="Rs.Window.Background" Color="{StaticResource Rs.Color.Background}"/>
    <SolidColorBrush x:Key="Rs.Surface" Color="{StaticResource Rs.Color.Surface}"/>
    <SolidColorBrush x:Key="Rs.Border" Color="{StaticResource Rs.Color.Border}"/>
    <SolidColorBrush x:Key="Rs.Text.Primary" Color="{StaticResource Rs.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Rs.Text.Muted" Color="{StaticResource Rs.Color.TextMuted}"/>
    <SolidColorBrush x:Key="Rs.Text.MutedDim" Color="{StaticResource Rs.Color.TextMutedDim}"/>
    <SolidColorBrush x:Key="Rs.Accent" Color="{StaticResource Rs.Color.Accent}"/>
    <SolidColorBrush x:Key="Rs.Accent.Dim" Color="{StaticResource Rs.Color.AccentDim}"/>
    <SolidColorBrush x:Key="Rs.Accent.Confirm" Color="{StaticResource Rs.Color.AccentConfirm}"/>
    <SolidColorBrush x:Key="Rs.Danger" Color="{StaticResource Rs.Color.Danger}"/>
    <SolidColorBrush x:Key="Rs.Danger.Dim" Color="{StaticResource Rs.Color.DangerDim}"/>
    <SolidColorBrush x:Key="Rs.OptionCard.Background" Color="{StaticResource Rs.Color.OptionCard}"/>
    <!-- Единая непрозрачная обводка 1px для карточки опций и выпадающего списка -->
    <SolidColorBrush x:Key="Rs.OptionCard.Border" Color="{StaticResource Rs.Color.Border}" Opacity="1"/>
    <SolidColorBrush x:Key="Rs.PillMuted.Background" Color="{StaticResource Rs.Color.PillMutedFill}"/>
    <SolidColorBrush x:Key="Rs.PillMuted.BackgroundHover" Color="#2D343E"/>

    <SolidColorBrush x:Key="Rs.Button.Accent.Background" Color="#122A28"/>
    <SolidColorBrush x:Key="Rs.Button.Danger.Background" Color="#2A1212"/>
    <SolidColorBrush x:Key="Rs.Button.Danger.Border" Color="#6F1F1F"/>
    <SolidColorBrush x:Key="Rs.Button.Danger.BorderHover" Color="#D43D3D"/>
    <SolidColorBrush x:Key="Rs.Button.Danger.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Rs.Button.Success.Background" Color="#12241A"/>
    <SolidColorBrush x:Key="Rs.Button.Success.Border" Color="#1F6F3D"/>
    <SolidColorBrush x:Key="Rs.Button.Success.BorderHover" Color="#3DD48A"/>
    <SolidColorBrush x:Key="Rs.Button.Success.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Rs.Button.PressedBackground" Color="#1C2128"/>
    <SolidColorBrush x:Key="Rs.TitleBar.ButtonHoverBackground" Color="#2D333B"/>
    <SolidColorBrush x:Key="Rs.TitleBar.ButtonPressedBackground" Color="#3D444D"/>
    <SolidColorBrush x:Key="Rs.TitleBar.CloseHoverBackground" Color="#E81123"/>
    <SolidColorBrush x:Key="Rs.TitleBar.ClosePressedBackground" Color="#C50F1F"/>
    <SolidColorBrush x:Key="Rs.TitleBar.CloseHoverForeground" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowBrushKey}" Color="{StaticResource Rs.Color.Surface}"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.WindowTextBrushKey}" Color="{StaticResource Rs.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightBrushKey}" Color="#FF2D333B"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.HighlightTextBrushKey}" Color="{StaticResource Rs.Color.TextPrimary}"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlBrushKey}" Color="{StaticResource Rs.Color.Surface}"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.ControlDarkBrushKey}" Color="{StaticResource Rs.Color.Border}"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InfoBrushKey}" Color="{StaticResource Rs.Color.Surface}"/>
    <SolidColorBrush x:Key="{x:Static sys:SystemColors.InfoTextBrushKey}" Color="{StaticResource Rs.Color.TextPrimary}"/>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Rs.Window.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Rs.Font.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
    </Style>

    <Style x:Key="Rs.TextBlock.ProfileActionIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Rs.Font.Mdl2}"/>
        <Setter Property="FontSize" Value="{DynamicResource Rs.ProfileAction.IconSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.ProfileAction.IconBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Rs.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Rs.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Rs.Surface}"
                            BorderBrush="{DynamicResource Rs.Border}"
                            BorderThickness="1" Padding="0,4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="24,6,32,6" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.TitleBar.ButtonHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{DynamicResource Rs.Border}" Height="1" Margin="8,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Muted}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Полосы прокрутки под тёмную тему (трек / бегунок; без «белого на белом») -->
    <Style x:Key="Rs.ScrollBar.LineButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" Height="0" Width="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd"
                            Background="#4C5863"
                            CornerRadius="4"
                            SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Rs.Text.Muted}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Rs.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="MinWidth" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                        <Border Margin="1,4"
                                VerticalAlignment="Stretch"
                                Background="#252B33"
                                CornerRadius="5"
                                Width="9"
                                HorizontalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Rs.ScrollBar.LineButton}" Command="ScrollBar.LineUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Rs.ScrollBar.LineButton}" Command="ScrollBar.LineDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Rs.ScrollBar.Thumb}" Margin="1,2"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="MinHeight" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Margin="4,1"
                                    Background="#252B33"
                                    CornerRadius="5"
                                    Height="9"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="False"
                                       Focusable="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Rs.ScrollBar.LineButton}" Command="ScrollBar.LineLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Rs.ScrollBar.LineButton}" Command="ScrollBar.LineRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Rs.ScrollBar.Thumb}" Margin="2,1"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Rs.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Rs.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" PopupAnimation="Slide">
                            <Border BorderThickness="1"
                                    Background="{DynamicResource Rs.Surface}"
                                    BorderBrush="{DynamicResource Rs.Border}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, ElementName=templateRoot}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Background="{DynamicResource Rs.Surface}">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False" ClickMode="Press"
                                      OverridesDefaultStyle="True" FocusVisualStyle="{x:Null}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="{DynamicResource Rs.Surface}"
                                      BorderBrush="{DynamicResource Rs.Border}"
                                      BorderThickness="1">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ToggleBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="1" Background="Transparent"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="1,0,0,0">
                                                <Path Data="M0,0 L4,4 L8,0 Z"
                                                      Fill="{DynamicResource Rs.Text.Primary}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" Stretch="None"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Rs.TitleBar.ButtonHoverBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Rs.TitleBar.ButtonPressedBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Rs.TitleBar.ButtonPressedBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                          Margin="8,0,28,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource Rs.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2D333B"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.TextBox.ResourceThreshold" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Rs.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Rs.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="MaxLength" Value="3"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Rs.RepeatButton.ResourceSpinner" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2D333B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.Button.PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.CheckBox" TargetType="CheckBox">
        <!-- По умолчанию (unchecked) текст серый -->
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.MutedDim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                CornerRadius="4"
                                Background="{DynamicResource Rs.Surface}"
                                BorderBrush="{DynamicResource Rs.Border}"
                                BorderThickness="1"
                                Margin="0,0,10,0"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Data="M2,8 L6,12 L14,3"
                                  StrokeThickness="2"
                                  Stroke="{DynamicResource Rs.Text.Primary}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <TextBlock x:Name="ContentText"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rs.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#1A3DD4C3"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rs.Accent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource Rs.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.Button" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Rs.Surface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Rs.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.Button.PressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.Button.Accent" TargetType="Button" BasedOn="{StaticResource Rs.Button}">
        <Setter Property="Background" Value="{DynamicResource Rs.Button.Accent.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Rs.Accent.Dim}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Accent}"/>
    </Style>

    <Style x:Key="Rs.Button.Danger" TargetType="Button" BasedOn="{StaticResource Rs.Button}">
        <Setter Property="Background" Value="{DynamicResource Rs.Button.Danger.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Rs.Button.Danger.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Button.Danger.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Button.Danger.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Button.Danger.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.Button.Success" TargetType="Button" BasedOn="{StaticResource Rs.Button}">
        <Setter Property="Background" Value="{DynamicResource Rs.Button.Success.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Rs.Button.Success.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Button.Success.Foreground}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Button.Success.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Rs.Button.Success.BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.TitleBar.Button" TargetType="Button">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource Rs.Font.Ui}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.TitleBar.ButtonHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.TitleBar.ButtonPressedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.TitleBar.Close" TargetType="Button" BasedOn="{StaticResource Rs.TitleBar.Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.TitleBar.CloseHoverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Rs.TitleBar.CloseHoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.TitleBar.ClosePressedBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Rs.TitleBar.CloseHoverForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Крестик: красная подложка при hover/press — круг (размер кнопки 36×36, CornerRadius 18). -->
    <Style x:Key="Rs.TitleBar.Close.Round" TargetType="Button" BasedOn="{StaticResource Rs.TitleBar.Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.TitleBar.CloseHoverBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Rs.TitleBar.CloseHoverForeground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Rs.TitleBar.ClosePressedBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Rs.TitleBar.CloseHoverForeground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Rs.TitleBar.AboutInfo" TargetType="Button">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="5,2,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Muted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="12" Height="12" SnapsToDevicePixels="True">
                        <Viewbox Width="12" Height="12" Stretch="Uniform">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource Rs.Font.Mdl2}"
                                       Text="&#xE946;"
                                       FontSize="14"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Viewbox>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Rs.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
