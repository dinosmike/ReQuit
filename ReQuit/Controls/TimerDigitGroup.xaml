<UserControl x:Class="ReQuit.Controls.TimerDigitGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="175"
             MouseEnter="OnGroupMouseEnter"
             MouseLeave="OnGroupMouseLeave">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="136"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <!-- Unit label (часы / минуты / секунды) -->
        <TextBlock x:Name="UnitLabel" Grid.Row="0"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Rs.Text.Muted}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,3"/>

        <!-- Up arrow chevron -->
        <Path x:Name="UpArrow" Grid.Row="1"
              Data="M 5,10 L 12,3 L 19,10"
              Stroke="{DynamicResource Rs.Accent}"
              StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Opacity="0" IsHitTestVisible="False"/>

        <!-- Digit display card -->
        <Border x:Name="DigitBorder" Grid.Row="2"
                CornerRadius="20"
                Background="#141D2B"
                BorderBrush="{DynamicResource Rs.Border}"
                BorderThickness="1.5"
                ClipToBounds="True"
                Cursor="SizeNS"
                MouseLeftButtonDown="OnDigitMouseDown"
                MouseRightButtonDown="OnDigitMouseRightButtonDown"
                MouseMove="OnDigitMouseMove"
                MouseLeftButtonUp="OnDigitMouseUp"
                MouseLeave="OnDigitMouseLeave"
                MouseWheel="OnDigitMouseWheel">
            <Grid>
                <!-- Current digit -->
                <TextBlock x:Name="CurrentText"
                           Text="00"
                           FontSize="88"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource Rs.Text.Primary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="CurrentTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Incoming digit (visible only during animation) -->
                <TextBlock x:Name="IncomingText"
                           Text="00"
                           FontSize="88"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource Rs.Text.Primary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="IncomingTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Top edge shadow for inset depth effect -->
                <Rectangle VerticalAlignment="Top" Height="32" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A0141D2B" Offset="0"/>
                            <GradientStop Color="#00141D2B" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Bottom edge shadow for inset depth effect -->
                <Rectangle VerticalAlignment="Bottom" Height="32" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00141D2B" Offset="0"/>
                            <GradientStop Color="#A0141D2B" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Horizontal slit line (flip-clock hinge) -->
                <Rectangle VerticalAlignment="Center" Height="1"
                           Fill="#18FFFFFF" IsHitTestVisible="False"
                           Margin="6,0"/>
            </Grid>
        </Border>

        <!-- Down arrow chevron -->
        <Path x:Name="DownArrow" Grid.Row="3"
              Data="M 5,3 L 12,10 L 19,3"
              Stroke="{DynamicResource Rs.Accent}"
              StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
