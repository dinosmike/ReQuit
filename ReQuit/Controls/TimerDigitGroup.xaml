<UserControl x:Class="ReQuit.Controls.TimerDigitGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="175"
             MouseEnter="OnGroupMouseEnter"
             MouseLeave="OnGroupMouseLeave">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="136"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <!-- Unit label (часы / минуты / секунды) -->
        <TextBlock x:Name="UnitLabel" Grid.Row="0"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Rs.Text.Muted}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,3"/>

        <!-- Up arrow chevron -->
        <Path x:Name="UpArrow" Grid.Row="1"
              Data="M 5,10 L 12,3 L 19,10"
              Stroke="{DynamicResource Rs.Accent}"
              StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Opacity="0" IsHitTestVisible="False"/>

        <!-- Digit display card -->
        <Border x:Name="DigitBorder" Grid.Row="2"
                CornerRadius="20"
                BorderBrush="{DynamicResource Rs.Border}"
                BorderThickness="1.5"
                ClipToBounds="True"
                Cursor="SizeNS"
                PreviewMouseDown="OnDigitPreviewMouseDown"
                MouseLeftButtonDown="OnDigitMouseDown"
                MouseRightButtonDown="OnDigitMouseRightButtonDown"
                MouseMove="OnDigitMouseMove"
                MouseLeftButtonUp="OnDigitMouseUp"
                MouseLeave="OnDigitMouseLeave"
                MouseWheel="OnDigitMouseWheel">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#141D2B" Offset="0"/>
                    <GradientStop Color="#1B263A" Offset="0.5"/>
                    <GradientStop Color="#141D2B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шов flip-clock — ниже по z-order, чем цифры (первым в списке дочерних) -->
                <Rectangle Grid.Row="0" VerticalAlignment="Center" Height="1"
                           Fill="#18FFFFFF" IsHitTestVisible="False"
                           Margin="6,0"/>

                <!-- Пара цифр по центру по горизонтали; по вертикали колонки на всю высоту циферблата — иначе ClipToBounds режет анимацию -->
                <Grid Grid.Row="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Десятки -->
                    <Grid Grid.Column="0"
                          VerticalAlignment="Stretch"
                          ClipToBounds="True">
                        <TextBlock x:Name="CurrentTensText"
                                   Text="0"
                                   FontSize="88"
                                   FontWeight="Bold"
                                   FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                                   Foreground="{DynamicResource Rs.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CurrentTensTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="IncomingTensText"
                                   Text="0"
                                   FontSize="88"
                                   FontWeight="Bold"
                                   FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                                   Foreground="{DynamicResource Rs.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="IncomingTensTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>

                    <!-- Единицы -->
                    <Grid Grid.Column="1"
                          VerticalAlignment="Stretch"
                          ClipToBounds="True">
                        <TextBlock x:Name="CurrentOnesText"
                                   Text="0"
                                   FontSize="88"
                                   FontWeight="Bold"
                                   FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                                   Foreground="{DynamicResource Rs.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CurrentOnesTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="IncomingOnesText"
                                   Text="0"
                                   FontSize="88"
                                   FontWeight="Bold"
                                   FontFamily="pack://application:,,,/Fonts/consolab.ttf#Consolas"
                                   Foreground="{DynamicResource Rs.Text.Primary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="IncomingOnesTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- Top edge shadow for inset depth effect -->
                <Rectangle Grid.Row="0" VerticalAlignment="Top" Height="32" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A0141D2B" Offset="0"/>
                            <GradientStop Color="#00141D2B" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Bottom edge shadow for inset depth effect -->
                <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="32" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00141D2B" Offset="0"/>
                            <GradientStop Color="#A0141D2B" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Белый оверлей при наведении: альфа 3/255 ≈ 1% -->
                <Rectangle x:Name="DialHoverOverlay" Grid.Row="0"
                           Fill="#03FFFFFF"
                           Opacity="0"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- Down arrow chevron -->
        <Path x:Name="DownArrow" Grid.Row="3"
              Data="M 5,3 L 12,10 L 19,3"
              Stroke="{DynamicResource Rs.Accent}"
              StrokeThickness="2.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
