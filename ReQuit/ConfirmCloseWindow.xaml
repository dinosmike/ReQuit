<Window x:Class="ReQuit.ConfirmCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title=""
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Width="420"
        MinHeight="120"
        SizeToContent="Height"
        UseLayoutRounding="True"
        Background="{DynamicResource Rs.Window.Background}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Rs.Border}"
            BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="44"
                    Background="{DynamicResource Rs.Surface}"
                    BorderBrush="{DynamicResource Rs.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            Padding="14,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Rs.Text.Primary}"
                                   Text="{DynamicResource Loc_MainWindow_ConfirmCloseTitle}"/>
                    </Border>
                    <Button Grid.Column="1"
                            Click="TitleBarClose_OnClick"
                            ToolTip="{DynamicResource Loc_MainWindow_ConfirmCloseTooltipDismiss}"
                            Style="{DynamicResource Rs.TitleBar.Close}"
                            Content="&#x00D7;"/>
                </Grid>
            </Border>

            <Border Padding="20,18,20,18">
                <StackPanel>
                    <TextBlock FontSize="14"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Rs.Text.Primary}"
                               Text="{DynamicResource Loc_MainWindow_ConfirmCloseActive}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,22,0,0">
                        <Button x:Name="BtnCancel"
                                MinWidth="100"
                                Padding="16,8"
                                Margin="0,0,10,0"
                                Style="{StaticResource Rs.Button}"
                                HorizontalContentAlignment="Center"
                                Click="BtnCancel_OnClick"
                                IsCancel="True"
                                IsDefault="True"
                                ToolTip="{DynamicResource Loc_MainWindow_ConfirmCloseTooltipCancel}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Rs.TextBlock.ProfileActionIcon}" Text="&#xE711;"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{DynamicResource Loc_MainWindow_ConfirmCloseCancel}"
                                           Foreground="{DynamicResource Rs.Text.Primary}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnYesClose"
                                MinWidth="200"
                                Padding="24,12"
                                FontSize="15"
                                Style="{StaticResource Rs.Button.Accent}"
                                Click="BtnYesClose_OnClick"
                                ToolTip="{DynamicResource Loc_MainWindow_ConfirmCloseTooltipStopExit}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Path Stroke="{DynamicResource Rs.Accent}"
                                              StrokeThickness="1.85"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M 3.5,8.2 L 6.8,11.2 L 12.5,4.8"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="15"
                                           Text="{DynamicResource Loc_MainWindow_ConfirmCloseStopExit}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
