<Window x:Class="ReQuit.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Loc_SettingsWindow_Title}"
        Width="340"
        MinHeight="100"
        MinWidth="280"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource Rs.Window.Background}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Rs.Border}"
            BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Height="44"
                    Background="{DynamicResource Rs.Surface}"
                    BorderBrush="{DynamicResource Rs.Border}"
                    BorderThickness="0,0,0,1"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            Padding="14,0,8,0"
                            MouseLeftButtonDown="TitleBar_OnMouseDown">
                        <TextBlock Text="{DynamicResource Loc_SettingsWindow_Title}"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Rs.Text.Primary}"/>
                    </Border>
                    <Button Grid.Column="1"
                            Click="TitleBarClose_OnClick"
                            ToolTip="{DynamicResource Loc_SettingsWindow_TooltipClose}"
                            Style="{DynamicResource Rs.TitleBar.Close}"
                            Content="&#x00D7;"/>
                </Grid>
            </Border>

            <Border Padding="20,18,20,20">
                <StackPanel>
                    <TextBlock FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"
                               Foreground="{DynamicResource Rs.Text.Muted}"
                               Text="{DynamicResource Loc_SettingsWindow_Placeholder}"/>
                    <CheckBox x:Name="TrayCloseCheck"
                              Margin="0,0,0,8"
                              Content="{DynamicResource Loc_SettingsWindow_TrayCloseLabel}"
                              Checked="TrayOption_OnChanged"
                              Unchecked="TrayOption_OnChanged"/>
                    <CheckBox x:Name="TrayStartupCheck"
                              Margin="0,0,0,8"
                              Content="{DynamicResource Loc_SettingsWindow_TrayStartupLabel}"
                              Checked="TrayOption_OnChanged"
                              Unchecked="TrayOption_OnChanged"/>
                    <CheckBox x:Name="TrayAnimCheck"
                              Content="{DynamicResource Loc_SettingsWindow_TrayAnimLabel}"
                              Checked="TrayOption_OnChanged"
                              Unchecked="TrayOption_OnChanged"/>
                </StackPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
